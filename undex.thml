<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的網頁程式作品集 | Macaron Portfolio</title>
    <!-- Google Fonts 夢幻字體 -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
    <style>
        /* ==========================================
           1. 全局變數與基礎設定 (Macaron Theme)
           ========================================== */
        :root {
            --bg-gradient: linear-gradient(135deg, #ffecd2 0%, #fcb69f 30%, #ff9a9e 60%, #fecfef 100%);
            --card-pink: #ffd1dc;
            --card-blue: #c4faf8;
            --card-purple: #e7c6ff;
            --card-yellow: #fcf6bd;
            --text-color: #5a4b5c;
            --text-muted: #8c7b8d;
            --locked-bg: rgba(255, 255, 255, 0.4);
            --locked-border: #d3c4d1;
            --shadow-soft: 0 10px 25px rgba(230, 160, 180, 0.25);
            --shadow-hover: 0 15px 30px rgba(230, 140, 170, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Fredoka', 'Noto Sans TC', sans-serif;
            background: var(--bg-gradient);
            background-size: 300% 300%;
            animation: gradientBG 15s ease infinite;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            color: var(--text-color);
            position: relative;
            overflow-x: hidden;
        }

        /* 背景流動動態 */
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* 背景飄浮夢幻氣泡 */
        .bubble {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.35);
            backdrop-filter: blur(2px);
            animation: float 8s infinite ease-in-out;
            z-index: 0;
            pointer-events: none;
        }

        .bubble:nth-child(1) { width: 90px; height: 90px; left: 10%; top: 20%; animation-duration: 9s; }
        .bubble:nth-child(2) { width: 60px; height: 60px; right: 15%; top: 15%; animation-duration: 7s; }
        .bubble:nth-child(3) { width: 110px; height: 110px; left: 15%; bottom: 10%; animation-duration: 11s; }
        .bubble:nth-child(4) { width: 50px; height: 50px; right: 10%; bottom: 20%; animation-duration: 8s; }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-25px) rotate(10deg); }
        }

        /* 主容器 */
        .container {
            max-width: 1000px;
            width: 100%;
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 30px;
            padding: 40px 30px;
            box-shadow: var(--shadow-soft);
            border: 2px solid rgba(255, 255, 255, 0.8);
            position: relative;
            z-index: 1;
            text-align: center;
        }

        /* ==========================================
           2. 個人個人資訊區域 (Header / Profile)
           ========================================== */
        .profile-section {
            margin-bottom: 35px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* 大頭貼旋轉外框動畫 */
        .avatar-wrapper {
            position: relative;
            width: 120px;
            height: 120px;
            margin-bottom: 15px;
        }

        .avatar-wrapper::before {
            content: '';
            position: absolute;
            top: -6px; left: -6px; right: -6px; bottom: -6px;
            background: linear-gradient(45deg, #ff9a9e, #fecfef, #a1c4fd, #c2e9fb);
            border-radius: 50%;
            z-index: 0;
            animation: spin 6s linear infinite;
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }

        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            position: relative;
            z-index: 1;
            border: 4px solid #ffffff;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

        .profile-name {
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: #4a3e4d;
            margin-bottom: 6px;
        }

        .profile-subtitle {
            font-size: 0.95rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.7);
            padding: 4px 16px;
            border-radius: 20px;
            display: inline-block;
        }

        /* ==========================================
           3. 網格卡片區域 (Grid Layout)
           ========================================== */
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 20px;
        }

        /* 卡片通用樣式 */
        .card {
            border-radius: 20px;
            padding: 20px 15px;
            text-decoration: none;
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 120px;
            position: relative;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 6px 15px rgba(0,0,0,0.03);
            border: 2px solid rgba(255, 255, 255, 0.9);
            overflow: hidden;
        }

        /* 微光過場動畫效果 */
        .card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                60deg,
                transparent 30%,
                rgba(255, 255, 255, 0.5) 50%,
                transparent 70%
            );
            transform: rotate(30deg) translateY(-100%);
            transition: transform 0.6s ease;
        }

        /* ==========================================
           4. 解鎖狀態 (Unlocked Cards)
           ========================================== */
        .card.unlocked {
            cursor: pointer;
        }

        .card.unlocked:nth-child(1) { background: linear-gradient(135deg, var(--card-pink), #ffe3e8); }
        .card.unlocked:nth-child(2) { background: linear-gradient(135deg, var(--card-blue), #e0fbfb); }

        .card.unlocked:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: var(--shadow-hover);
        }

        .card.unlocked:hover::after {
            transform: rotate(30deg) translateY(100%);
        }

        .badge-unlocked {
            font-size: 0.75rem;
            background: #ffffff;
            color: #ff758c;
            padding: 3px 10px;
            border-radius: 12px;
            font-weight: 600;
            margin-bottom: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        /* ==========================================
           5. 未解鎖狀態 (Locked Cards)
           ========================================== */
        .card.locked {
            background: var(--locked-bg);
            border-color: var(--locked-border);
            color: #a093a2;
            cursor: not-allowed;
            backdrop-filter: blur(4px);
        }

        .card-lock-icon {
            font-size: 1.5rem;
            margin-bottom: 6px;
            filter: grayscale(0.2);
            transition: transform 0.3s ease;
        }

        /* 未解鎖懸浮抖動動畫 (Shake Effect) */
        .card.locked:hover {
            animation: shake 0.4s ease-in-out;
            background: rgba(240, 235, 240, 0.6);
        }

        .card.locked:hover .card-lock-icon {
            transform: scale(1.2) rotate(-10deg);
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-5px) rotate(-2deg); }
            40% { transform: translateX(5px) rotate(2deg); }
            60% { transform: translateX(-3px); }
            80% { transform: translateX(3px); }
        }

        .card-title {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.3;
        }

        /* Tooltip 闖關提示框 */
        .card.locked::before {
            content: '🔒 關卡未開放';
            position: absolute;
            top: 10px;
            background: rgba(90, 75, 92, 0.85);
            color: #fff;
            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 6px;
            opacity: 0;
            transform: translateY(5px);
            transition: all 0.3s ease;
            pointer-events: none;
            white-space: nowrap;
        }

        .card.locked:hover::before {
            opacity: 1;
            transform: translateY(0);
        }

        /* ==========================================
           6. 響應式斷點設計 (Responsive RWD)
           ========================================== */
        /* 平板尺寸 (900px 以下) -> 改為 3 欄 */
        @media (max-width: 900px) {
            .portfolio-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* 手機尺寸 (600px 以下) -> 改為 2 欄 */
        @media (max-width: 600px) {
            .container {
                padding: 30px 15px;
            }

            .portfolio-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .card {
                padding: 15px 10px;
                min-height: 100px;
            }

            .card-title {
                font-size: 0.88rem;
            }

            .profile-name {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>

    <!-- 夢幻氣泡裝飾 -->
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>

    <!-- 主內容區 -->
    <main class="container">
        
        <!-- 大頭貼與個人簡介區 -->
        <header class="profile-section">
            <div class="avatar-wrapper">
                <!-- 預設假圖片大頭貼 (可替換為你的圖片路徑) -->
                <img src="https://i.postimg.cc/MGGvJhvq/unnamed.jpg" alt="大頭貼" class="avatar">
            </div>
            <h1 class="profile-name">謝家弘</h1>
            <p class="profile-subtitle">✨ 網頁程式設計作品集 ✦ 冒險關卡 ✨</p>
        </header>

        <!-- 16 個關卡按鈕區 -->
        <section class="portfolio-grid">

            <!-- 按鈕 1: 已解鎖 -->
            <a href="w1/index.html" class="card unlocked">
                <span class="badge-unlocked">✨ 已解鎖</span>
                <span class="card-title">Week 1<br>數位名片</span>
            </a>

            <!-- 按鈕 2: 已解鎖 -->
            <a href="w2/index.html" class="card unlocked">
                <span class="badge-unlocked">✨ 已解鎖</span>
                <span class="card-title">Week 2<br>今天吃甚麼?</span>
            </a>

            <!-- 按鈕 3 - 16: 未解鎖灰色關卡 -->
            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 3</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 4</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 5</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 6</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 7</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 8</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 9</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 10</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 11</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 12</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 13</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 14</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 15</span>
            </div>

            <div class="card locked">
                <span class="card-lock-icon">🔒</span>
                <span class="card-title">Week 16</span>
            </div>

        </section>
    </main>

</body>
</html>
